// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  address        String
  phone          String
  isApproved     Boolean  @default(true)
  isActive       Boolean  @default(true)
  isAvailable    Boolean  @default(true)
  currentTickets Int      @default(0)
  createdAt      DateTime @default(now())

  userTypes   user_userType[]
  userRoles   user_userRole[]
  departments user_department[]
}

model userTypes {
  id           Int      @id @default(autoincrement())
  userTypeName String   @unique
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  users user_userType[]
}

model user_userType {
  id         Int @id @default(autoincrement())
  userId     Int
  usertypeId Int

  user     user      @relation(fields: [userId], references: [id])
  userType userTypes @relation(fields: [usertypeId], references: [id])
}

model userRole {
  id           Int      @id @default(autoincrement())
  userRoleName String   @unique
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  users user_userRole[]
}

model user_userRole {
  id         Int @id @default(autoincrement())
  userId     Int
  userRoleId Int

  user     user     @relation(fields: [userId], references: [id])
  userRole userRole @relation(fields: [userRoleId], references: [id])
}

model department {
  id             Int      @id @default(autoincrement())
  departmentName String   @unique
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(true)

  users user_department[]
}

model user_department {
  id           Int @id @default(autoincrement())
  userId       Int
  departmentId Int

  user       user       @relation(fields: [userId], references: [id])
  department department @relation(fields: [departmentId], references: [id])
}
