generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  STAFF
  FRONTDESK
  SUPERVISOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  DONE
  VERIFIED
  CLOSED
  REOPENED
  CANCELLED
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String?
  lastName  String?
  email     String  @unique
  password  String
  phone     String  @unique
  nid       String  @unique

  userType UserType

  createdAt DateTime @default(now())

  createdTickets  Ticket[]              @relation("CreatedBy")
  assignedTickets Ticket[]              @relation("AssignedTo")
  statusChanged   TicketStatusHistory[]
  Department      Department?
  StaffRole       StaffRole[]
  AuditLog        AuditLog[]
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  supervisorId Int? @unique

  createdAt DateTime @default(now())

  supervisor User? @relation(fields: [supervisorId], references: [id])

  roles   Role[]
  tickets Ticket[]
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String @unique
  description String?

  departmentId Int

  department Department  @relation(fields: [departmentId], references: [id])
  staffRoles StaffRole[]

  @@unique([name, departmentId])
}

model StaffRole {
  id      Int @id @default(autoincrement())
  staffId Int
  roleId  Int

  staff User @relation(fields: [staffId], references: [id])
  role  Role @relation(fields: [roleId], references: [id])

  @@unique([staffId, roleId])
}

model Ticket {
  id          Int     @id @default(autoincrement())
  ticketCode  String  @unique
  roomNumber  Int?
  title       String
  description String?
  feedback    String?

  priority Priority     @default(MEDIUM)
  status   TicketStatus @default(OPEN)

  creatorId    Int
  departmentId Int

  assignTo Int?
  assignBy Int?

  deadline DateTime?
  assignAt DateTime?

  createdAt DateTime @default(now())

  creator    User       @relation("CreatedBy", fields: [creatorId], references: [id])
  assignee   User?      @relation("AssignedTo", fields: [assignTo], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  history TicketStatusHistory[]

  @@index([departmentId])
  @@index([status])
  @@index([assignTo])
}

model TicketStatusHistory {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  status    TicketStatus
  changedBy Int
  changedAt DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [changedBy], references: [id])

  @@index([ticketId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  userId      Int
  action      String
  method      String
  path        String
  requestBody String?

  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}
