// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  email String        @unique
  password String
  address String
  phone String
  isApproved Boolean  @default(true)
  isActive Boolean    @default(true)
  isAvailable Boolean @default(true)
  currentTickets Int  @default(0)
  createdAt DateTime  @default(now())

  userTypes    user_userType[]
  userRoles    user_userRole[]
  departments  user_department[]
  tickets tickets[]
  assignment  ticketAssignment[]
  statuses   ticketStatus[]
}

model userTypes {
  id Int @id @default(autoincrement())
  userTypeName String @unique
  createdAt DateTime @default(now())
  isActive Boolean @default(true)

   users       user_userType[]
} 

model user_userType {
  id Int @id @default(autoincrement())
  userId Int
  usertypeId Int 

  user        user          @relation(fields: [userId], references: [id])
  userType     userTypes      @relation(fields: [usertypeId], references: [id])
  
}

model userRole {
  id Int @id @default(autoincrement())
  userRoleName String @unique
  createdAt DateTime @default(now())
  isActive Boolean @default(true)

  users user_userRole[]
}

model user_userRole{
  id Int @id @default(autoincrement())
  userId Int
  userRoleId Int 

  user  user   @relation(fields: [userId], references: [id])
  userRole userRole @relation(fields: [userRoleId], references: [id])
}

model department {
  id Int @id @default(autoincrement())
  departmentName String @unique
  createdAt DateTime @default(now())
  isActive Boolean @default(true)

  users user_department[]
  issueTypes  issueType[]

}

model user_department {
  id Int @id @default(autoincrement())
  userId Int
  departmentId Int

  user user @relation(fields: [userId], references: [id])
  department department @relation(fields: [departmentId], references: [id])
}

model tickets {
  id  Int @id @default(autoincrement())
  ticketCode      String @unique
  roomNumber      Int
  title           String
  description     String
  rating          Int?
  feedback        String?
  creatorId       Int
  priorityId      Int
  issueTypeId     Int
  currentStatusId Int
  createdAt       DateTime  @default(now())

  user            user     @relation(fields: [creatorId], references: [id])
  priority        ticketPriority @relation(fields: [priorityId], references: [id])
  statusType      statusType @relation(fields: [currentStatusId], references: [id])
  issueType       issueType @relation(fields: [issueTypeId], references: [id])
  assignment  ticketAssignment[]
  statuses    ticketStatus[]

}

model ticketPriority {
  id     Int      @id @default(autoincrement())
  name   String   @unique

  tickets tickets[]
}

model issueType {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  departmentId Int

  tickets tickets[]
  department   department   @relation(fields: [departmentId], references: [id])

}

model statusType {
  id Int @id @default(autoincrement())
  name String @unique

  tickets tickets[]
  statuses ticketStatus[]
}

model ticketAssignment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  assignTo    Int
  assignedAt DateTime @default(now())
  deadline DateTime?
  closeAt DateTime?
  comment    String?

  staff      user     @relation(fields: [assignTo], references: [id])
  ticket     tickets   @relation(fields: [ticketId], references: [id])
   @@unique([ticketId]) // One ticket = one assignment
}

model ticketStatus{
  id Int @id @default(autoincrement())
  ticketId Int
  changnedBy Int
  statusId Int
  changedAt DateTime @default(now())
  comment String

  ticket tickets  @relation(fields: [ticketId], references: [id])
  user user       @relation(fields: [changnedBy], references: [id])
  status statusType @relation(fields: [statusId], references: [id])
  
}